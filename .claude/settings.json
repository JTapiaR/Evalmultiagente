{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m py_compile *)",
      "Bash(pip install -r requirements.txt)",
      "Bash(python iniciar.py)",
      "Bash(python paso1_crear_sistema.py)",
      "Bash(python paso1_crear_sistema.py *)"
    ],
    "ask": [
      "Bash(python paso2_procesar_cv.py)",
      "Bash(python paso2_procesar_cv.py *)",
      "Bash(python paso3_evaluar.py)",
      "Bash(python paso3_evaluar.py *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Bash(cat .env*)",
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guardia.py"]}]}
    ],
    "PostToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/registro.py"]}]}
    ]
  }
}
